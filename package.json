{
  "name": "multiplayer-pong",
  "version": "2.0.0-dev",
  "description": "Server-authoritative multiplayer Pong with client-side prediction, reconciliation, entity interpolation and a built-in network lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch-path=server --watch-path=shared server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "ISC",
  "dependencies": {
    "express": "5.2.1",
    "helmet": "8.3.0",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "socket.io-client": "4.8.4",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
