# Copy to .env for local overrides. .env is gitignored: never commit secrets.
# (This project has no secrets today; keep it that way.)

# Port the Node server listens on.
PORT=3000

# Comma-separated origins allowed to open a socket (no "*", no trailing slash).
# Local default: the Vite dev server (5173) and this server (3000) on localhost/127.0.0.1.
# Production example: https://pong.example.com
ALLOWED_ORIGINS=

# "production" enforces https:// origins and HSTS.
NODE_ENV=development

# Real client IP for per-IP limits behind a proxy.
# CLIENT_IP_HEADER=true-client-ip
# TRUST_PROXY_HOPS=1

# Serve the built client (client/dist, from `npm run build`) from this server.
SERVE_CLIENT=true

# Snapshots per second. Must divide the 60 Hz tick rate (10, 15, 20, 30, 60...).
SNAPSHOT_RATE=20

# Bounded lag compensation for paddle hits (off by default; see SECURITY.md).
LAG_COMPENSATION=false
LAG_COMPENSATION_MAX_MS=150

# Optional limits
# MAX_ROOMS=200
# MAX_CONNECTIONS_PER_IP=20

# Log the server loop's timing (gaps between runs, time per run, ticks
# skipped) and memory every N ms. 0 = off. Used by scripts/bench/load.ts.
LOOP_STATS_MS=0
